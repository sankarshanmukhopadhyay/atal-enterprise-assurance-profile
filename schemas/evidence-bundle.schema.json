{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atal-eap/schemas/evidence-bundle.schema.json",
  "title": "EAP Evidence Bundle Schema",
  "description": "Validates an EAP evidence bundle, which collects all control evidence items for an assessment against a named assurance level.",
  "type": "object",
  "required": [
    "bundle_id", "assurance_level", "assessment_period",
    "assessed_system", "attestation", "control_evidence_items"
  ],
  "properties": {
    "bundle_id": { "type": "string" },
    "assurance_level": {
      "type": "string",
      "enum": ["EAP-L1", "EAP-L2", "EAP-L3"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "assessment_period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "assessed_system": {
      "type": "object",
      "required": ["name", "version", "environment"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "environment": { "type": "string" },
        "deployment_context_ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "attestation": {
      "type": "object",
      "required": ["attested_by", "attestation_date"],
      "properties": {
        "attested_by": { "type": "string" },
        "attestation_date": { "type": "string", "format": "date" },
        "attestation_role": { "type": "string" },
        "signature": { "type": "string" }
      },
      "additionalProperties": true
    },
    "control_evidence_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control_id", "status", "evidence_artifacts"],
        "properties": {
          "control_id": { "type": "string", "pattern": "^EAP-CTRL-\\d{3}$" },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "partial", "not_applicable", "waived"]
          },
          "notes": { "type": "string" },
          "exception_ref": { "type": "string" },
          "evidence_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["artifact_id", "description"],
              "properties": {
                "artifact_id": { "type": "string" },
                "description": { "type": "string" },
                "path_or_url": { "type": "string" },
                "sha256": {
                  "description": "SHA-256 hex digest of the artifact (64 lowercase hex chars). Omit or leave null if not yet computed.",
                  "oneOf": [
                    { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
                    { "type": "null" }
                  ]
                },
                "artifact_type": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "exception_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
