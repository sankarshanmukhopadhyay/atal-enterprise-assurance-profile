{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sankarshanmukhopadhyay/atal-enterprise-assurance-profile/schemas/test-case.schema.json",
  "title": "EAP Executable Test Case",
  "type": "object",
  "required": ["schema_version", "test_id", "title", "control_ids", "assurance_levels", "objective", "preconditions", "stimulus", "observations", "pass_condition", "evidence_grade"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "test_id": {"type": "string", "pattern": "^EAP-TEST-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "control_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EAP-CTRL-[0-9]{3}$"}},
    "assurance_levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["EAP-L1", "EAP-L2", "EAP-L3"]}},
    "objective": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "stimulus": {"type": "object", "required": ["action"], "properties": {"action": {"type": "string", "minLength": 1}, "parameters": {"type": "object"}}, "additionalProperties": false},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "pass_condition": {"type": "string", "minLength": 1},
    "evidence_grade": {"enum": ["E3", "E4", "E5"]},
    "destructive": {"type": "boolean", "default": false}
  },
  "additionalProperties": false
}
