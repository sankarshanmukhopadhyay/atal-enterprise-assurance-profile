{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sankarshanmukhopadhyay/atal-enterprise-assurance-profile/schemas/upstream-baseline.schema.json",
  "title": "EAP Upstream Baseline",
  "type": "object",
  "required": ["schema_version", "eap_version", "upstream", "assurance"],
  "properties": {
    "schema_version": {"type": "string"},
    "eap_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "upstream": {
      "type": "object",
      "required": ["repository", "specification_version", "commit", "compatibility_class", "assessed_at", "normative_document"],
      "properties": {
        "repository": {"const": "Elytra-Security/atal-standard"},
        "specification_version": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "compatibility_class": {"enum": ["strict-compatible", "constrained-compatible", "extended-compatible"]},
        "assessed_at": {"type": "string", "format": "date"},
        "normative_document": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assurance": {
      "type": "object",
      "required": ["mapping_policy", "release_policy", "stale_when"],
      "properties": {
        "mapping_policy": {"type": "string", "minLength": 1},
        "release_policy": {"type": "string", "minLength": 1},
        "stale_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "additionalProperties": false
}
