{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atal-eap/schemas/control-catalog.schema.json",
  "title": "EAP Control Catalog Schema",
  "description": "Validates a canonical ATAL Enterprise Assurance Profile control catalog.",
  "type": "object",
  "required": ["catalog_id", "title", "version", "release_date", "status", "controls"],
  "properties": {
    "catalog_id": { "type": "string" },
    "title": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "release_date": { "type": "string", "format": "date" },
    "description": { "type": "string" },
    "upstream_standard": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "stable", "deprecated"] },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "title", "family", "statement", "rationale",
          "assurance_levels", "normative_strength", "control_type",
          "criticality", "test_methods", "evidence_requirements",
          "mapped_atal_references", "mapped_repo_sources",
          "related_risks", "compensating_controls", "automation_candidate"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EAP-CTRL-\\d{3}$",
            "description": "Stable control identifier in the form EAP-CTRL-NNN"
          },
          "title": { "type": "string" },
          "family": {
            "type": "string",
            "enum": [
              "Governance", "Enforcement", "Oversight", "Security",
              "Resilience", "Forensics and Reconstruction", "Vendor and Integration", "Evidence and Assurance"
            ]
          },
          "statement": { "type": "string" },
          "rationale": { "type": "string" },
          "assurance_levels": {
            "type": "array",
            "items": { "type": "string", "enum": ["EAP-L1", "EAP-L2", "EAP-L3"] },
            "minItems": 1
          },
          "normative_strength": {
            "type": "string",
            "enum": ["MUST", "SHOULD", "MAY"]
          },
          "control_type": {
            "type": "string",
            "enum": ["technical", "operational", "assurance"]
          },
          "criticality": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "test_methods": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "evidence_requirements": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "mapped_atal_references": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mapped_repo_sources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "related_risks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "compensating_controls": {
            "type": "array",
            "items": { "type": "string", "pattern": "^EAP-CTRL-\\d{3}$" }
          },
          "automation_candidate": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
