{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sankarshanmukhopadhyay/atal-enterprise-assurance-profile/schemas/test-result.schema.json",
  "title": "EAP Executable Test Result",
  "type": "object",
  "required": ["schema_version", "test_id", "control_ids", "subject", "started_at", "completed_at", "result", "observations", "evidence", "runner"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "test_id": {"type": "string", "pattern": "^EAP-TEST-[A-Z0-9-]+$"},
    "control_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EAP-CTRL-[0-9]{3}$"}},
    "subject": {"type": "object", "required": ["system_id", "deployment_id"], "properties": {"system_id": {"type": "string"}, "deployment_id": {"type": "string"}}, "additionalProperties": false},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["pass", "fail", "indeterminate", "error"]},
    "observations": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["artifact_type", "path_or_url"], "properties": {"artifact_type": {"type": "string"}, "path_or_url": {"type": "string"}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}},
    "runner": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "adapter": {"type": ["string", "null"]}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
